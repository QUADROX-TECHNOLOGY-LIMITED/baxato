# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
DASHBOARD_URL=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/baxato_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis / Caching
REDIS_URL=redis://localhost:6379

# Authentication & Identity (Clerk & JWT)
JWT_SECRET=your_jwt_secret_min_16_chars
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# WhatsApp Cloud API (Meta WhatsApp Business Platform)
WHATSAPP_API_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
WHATSAPP_APP_ID=...
WHATSAPP_TEMPLATE_NAME=registration_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_GB

# Monnify (Dual Provider & Virtual Accounts)
MONNIFY_API_KEY=MK_TEST_...
MONNIFY_SECRET_KEY=MS_TEST_...
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_CONTRACT_CODE=...
MONNIFY_WALLET_ACCOUNT_NUMBER=...

# VTpass Provider (Airtime, Electricity & Bills)
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_SECRET_KEY=SK_your_vtpass_secret_key
VTPASS_PUBLIC_KEY=PK_your_vtpass_public_key

# Security & Webhooks
WEBHOOK_SIGNING_SECRET=...
ENCRYPTION_MASTER_KEY=...
