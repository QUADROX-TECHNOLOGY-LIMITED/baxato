# ==============================================================================
# BAXATO — Ironclad .gitignore
# ==============================================================================

# Secrets & Environment Variables (NEVER COMMIT SECRETS TO REPOSITORY)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# Node Dependencies
node_modules/
.pnpm-store/

# TypeScript & Build Outputs
dist/
build/
.turbo/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Coverage
coverage/
.nyc_output/
.vitest/

# OS & System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
scratch/
scripts/

# Architecture Designs & Documentation (Private)
*.md
docs/

