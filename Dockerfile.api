# ==============================================================================
# BAXATO API Gateway — Production Multi-Stage Dockerfile
# ==============================================================================

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate

# Stage 1: Build dependencies & packages
FROM base AS builder
WORKDIR /app

# Copy workspace configuration & manifests
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json tsconfig.json ./
COPY packages/common/package.json ./packages/common/
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY apps/api/package.json ./apps/api/

# Install all dependencies (frozen lockfile)
RUN pnpm install --frozen-lockfile

# Copy monorepo source files
COPY packages/common ./packages/common
COPY packages/config ./packages/config
COPY packages/database ./packages/database
COPY apps/api ./apps/api

# Compile TypeScript packages and API
RUN pnpm --filter @baxato/common build
RUN pnpm --filter @baxato/config build
RUN pnpm --filter @baxato/database build
RUN pnpm --filter @baxato/api build

# Prune devDependencies for clean production container
RUN CI=true pnpm prune --prod --config.confirmModulesPurge=false

# Stage 2: Minimal Production Runtime
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

# Non-root user for security compliance
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 baxato

COPY --from=builder --chown=baxato:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=baxato:nodejs /app/packages ./packages
COPY --from=builder --chown=baxato:nodejs /app/apps/api ./apps/api
COPY --from=builder --chown=baxato:nodejs /app/package.json ./package.json

USER baxato
WORKDIR /app/apps/api

EXPOSE 4000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4000/v1/health/live || exit 1

CMD ["node", "dist/index.js"]
