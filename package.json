{
  "name": "baxato-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BAXATO — High-Performance VTU & Bill Payments Platform",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" --filter=\"./apps/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "dev:api": "pnpm --filter @baxato/api dev",
    "dev:dashboard": "pnpm --filter @baxato/dashboard dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
