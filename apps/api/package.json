{
  "name": "@baxato/api",
  "version": "1.0.0",
  "description": "BAXATO RESTful API Gateway",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "start": "node --import tsx dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@baxato/common": "workspace:*",
    "@baxato/config": "workspace:*",
    "@baxato/database": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.8.1",
    "@scalar/fastify-api-reference": "^1.69.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
